VITE_API_BASE_URL=http://localhost:5000/api

# Google Maps — Live Location, route replay, party locations.
# Google Cloud Console → APIs & Services → Credentials → API key, with the
# "Maps JavaScript API" enabled. Restrict it to your domain (HTTP referrers).
# Leave empty to use the built-in preview map during UI development.
VITE_GOOGLE_MAPS_API_KEY=
# Optional Map ID (Cloud Console → Map Management) for custom styling.
# Leave empty to use Google's DEMO_MAP_ID.
VITE_GOOGLE_MAPS_MAP_ID=
